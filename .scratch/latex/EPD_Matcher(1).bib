@misc{Kaus.2025,
 abstract = {Die Bedeutung des `Baus' kann auf verschiedene Weise herausgestellt werden. Sei es der Anteil der nominalen Bauinvestitionen am Bruttoinlandsprodukt Deutschlands von rd. 10{\%}, der Anteil der Branche an Treibhausgasemissionen, der je nach Betrachtungsweise zwischen 30{\%} und 50{\%} liegt, oder aber die Versorgung der Gesellschaft mit Infrastruktur. Es wird deutlich, wie wichtig Forschung und Entwicklung im Bauwesen f{\"u}r die Gesellschaft ist. Noch deutlicher wird der Bedarf, wenn man die konstante oder leicht sinkende Arbeitsproduktivit{\"a}t im Baugewerbe registriert, w{\"a}hrend in anderen Branchen Innovationsspr{\"u}nge und Effizienzsteigerungen teilweise zu betr{\"a}chtlichen Steigerungen der Arbeitsproduktivit{\"a}t f{\"u}hren. Auch eine immer noch schleppende Digitalisierung im Planen und Bauen oder eine h{\"a}ufig von Kosten{\"u}berschreitungen, Verz{\"o}gerungen und Konflikten gehemmte Projektabwicklung sind Bereiche, in denen die Baubranche hinter anderen Branchen zur{\"u}ckbleibt. Um diesen Entwicklungen entgegen zu wirken, wird an den Lehrst{\"u}hlen der {\"u}ber 40 Professor*innen des BBB-Netzwerks in der DACH-Region geforscht. Wie vielf{\"a}ltig die Themenbereiche des Bauens und die damit verbundene Forschung sein k{\"o}nnen, l{\"a}sst sich durch einen Blick auf das Inhaltsverzeichnis des Tagungsbandes nur erahnen. Sie reichen von der Lehre, {\"u}ber die Digitalisierung und Simulation von Prozessen, der robotergest{\"u}tzten Fertigung bis hin zur Anwendung von KI-Methoden im Bauwesen. Die Ergebnisse und Zwischenst{\"a}nde der wissenschaftlichen Auseinandersetzung mit den unterschiedlichen Themenbereichen werden u.a. j{\"a}hrlich im Rahmen der BBB Assistent*innen-Tagung vorgestellt und diskutiert. Vom 02. bis 04.07.2025 fand die 34. BBB Assistent*innen-Tagung an der Technischen Universit{\"a}t Berlin statt. Gastgeber war das Fachgebiet Bauwirtschaft und Baubetrieb mit Unterst{\"u}tzung des InnovationsZentrums Bau e.V.. Ziel der Tagung ist es, Doktorand*innen und wissenschaftlichen Mitarbeiter*innen der Fachbereiche Baubetrieb, Bauwirtschaft und Baumanagement einen Rahmen f{\"u}r Austausch und Vernetzung zu geben. Neben dem wissenschaftlichen Diskurs, bietet die BBB Assistent*innen-Tagung die M{\"o}glichkeit, die gastgebende Hochschule, deren Lehrbetrieb und die dort aktuellen Forschungsprojekte kennenzulernen. Dieses Format kann somit eine Ausgangsbasis f{\"u}r die Initiierung von hochschul{\"u}bergreifenden Kooperationen sein und bietet Inspiration und Ankn{\"u}pfungspunkte f{\"u}r neue Forschungsfragen im Bauwesen.},
 author = {Kaus, Michelle and Barkmann, Emilia},
 date = {2025},
 title = {Tagungsband 34. BBB Assistent*innen-Tagung 2025 Berlin: Chancen und Herausforderungen von digitalen Materialp{\"a}ssen f{\"u}r Infrastrukturprojekte},
 keywords = {000 Informatik;300 Sozialwissenschaften::330 Wirtschaft::330 Wirtschaft;300 Sozialwissenschaften::340 Recht::340 Recht;300 Sozialwissenschaften::350 {\"O}ffentliche Verwaltung;600 Technik;700 K{\"u}nste und Unterhaltung::720 Architektur::720 Architektur;allgemeine Werke;allgemeine Werke::000 Informatik;angewandte Wissenschaften::620 Ingenieurwissenschaften::620 Ingenieurwissenschaften und zugeordnete T{\"a}tigkeiten;angewandte Wissenschaften::620 Ingenieurwissenschaften::622 Bergbau und verwandte T{\"a}tigkeiten;angewandte Wissenschaften::620 Ingenieurwissenschaften::624 Ingenieurbau;angewandte Wissenschaften::620 Ingenieurwissenschaften::625 Eisenbahn- und Stra{\ss}enbau;angewandte Wissenschaften::690 Hausbau;Autobahnbau;Automatisierung;Baubetrieb;Bauhandwerk;Bauhandwerk::690 Hausbau;Bauprojektmangement;Baurobotik;Baustellenlogistik;Bauwerkserhaltung;Bauwirtschaft;Br{\"u}ckenbau;digitaler Materialpass;digitaler Zwilling;Digitalisierung;Informationswissenschaft;Infrastrukturbau;IOT;IPA;IPD;K{\"u}nstliche Intelligenz;Materialfluss;mechanised tunnelling;Medizin;Milit{\"a}rwissenschaft::351 {\"O}ffentliche Verwaltung;Milit{\"a}rwissenschaft::354 Verwaltung von Wirtschaft und Umwelt;Nachhaltigkeit;Planfeststellungsverfahren;Systeme::000 Informatik;Verg{\"u}tungsmodell;Wissen},
